# --- K-GEO web app (Next.js) ---
# Browser-safe Supabase values (exposed in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase service-role key (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Server-only Supabase URL used by the PR/recommendation admin client
SUPABASE_URL=https://your-project.supabase.co

# Exact deployed origin, no trailing slash. Used to build auth email redirects.
SITE_URL=http://localhost:3000

# Internal domain used to isolate counselor authentication identities
K_GEO_COUNSELOR_AUTH_DOMAIN=counselor-auth.Kgeo.internal

# --- Personal Recommendation (PR) backend integration ---
# Base URL of the KGEO PR backend service and the shared secret used to call it
KGEO_BACKEND_URL=http://localhost:4000
INTERNAL_API_SECRET=replace_me

# Gemini API key used by the PR backend
GEMINI_API_KEY=your api key here